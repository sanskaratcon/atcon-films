# Cloudflare headers for the static site (works on Workers and Pages).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Asset filenames are content hashes, so they never change: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Runtime and styles keep fixed names: cache for a day, revalidate after.
/vendor/*
  Cache-Control: public, max-age=86400
/support.js
  Cache-Control: public, max-age=86400
/atcon-ds.css
  Cache-Control: public, max-age=86400
